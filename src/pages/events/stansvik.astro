---
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import Support from '../../components/Support.astro';
import JsonLd from '../../components/JsonLd.astro';
import ScheduleList, { type ScheduleEntry } from '../../components/ScheduleList.astro';
import { organizationSchema, ORGANIZATION_ID_FRAGMENT } from '../../data/organization';
import { countryMeta } from '../../data/countries';

const siteUrl = Astro.site;
if (!siteUrl) throw new Error('Astro.site must be configured in astro.config.mjs');

const PAGE_PATH = '/events/stansvik/';
const pageUrl = new URL(PAGE_PATH, siteUrl).href;
const EVENT_DATE = '2026-08-30';
const TZ_OFFSET = '+03:00'; // Finland observes EEST in August
const FACEBOOK_EVENT_URL = 'https://fb.me/e/8YXtboCnh';
const REGISTRATION_URL = 'https://forms.gle/TF4e82E3p4GYRaD2A';
const SPOTIFY_URLS = {
  barboraXu: 'https://open.spotify.com/artist/2GKK9tOmJ5WLDoqEFLJwAN',
  tapaniRinne: 'https://open.spotify.com/artist/3444FAqjOpZGe7qdyshHg1',
  niklasWinter: 'https://open.spotify.com/artist/7z8P55fksPikrpZlDkmqdo',
};

const scheduleFi: ScheduleEntry[] = [
  { time: '13.00', datetime: `${EVENT_DATE}T13:00:00${TZ_OFFSET}`, what: [{ text: 'Pidempi opastettu kävely' }] },
  { time: '13.30', datetime: `${EVENT_DATE}T13:30:00${TZ_OFFSET}`, what: [{ text: 'Lyhyempi opastettu kävely' }] },
  { time: '15.00', datetime: `${EVENT_DATE}T15:00:00${TZ_OFFSET}`, what: [{ text: 'Metsäkonsertti' }] },
];

const scheduleEn: ScheduleEntry[] = [
  { time: '13:00', datetime: `${EVENT_DATE}T13:00:00${TZ_OFFSET}`, what: [{ text: 'Longer guided walk' }] },
  { time: '13:30', datetime: `${EVENT_DATE}T13:30:00${TZ_OFFSET}`, what: [{ text: 'Shorter guided walk' }] },
  { time: '15:00', datetime: `${EVENT_DATE}T15:00:00${TZ_OFFSET}`, what: [{ text: 'Forest concert' }] },
];

const description =
  'Old Forest Echoes forest concert with Barbora Xu in Stansvik Forest, Laajasalo, Helsinki, on Sunday 30 August 2026. Guided forest walks begin at 13:00 and 13:30; the concert begins at 15:00.';

const eventGraph = {
  '@context': 'https://schema.org' as const,
  '@graph': [
    organizationSchema(siteUrl),
    {
      '@type': 'MusicEvent',
      '@id': `${pageUrl}#event`,
      name: 'Old Forest Echoes — Forest Concert in Stansvik, Helsinki',
      description,
      image: new URL('/images/og-image-landscape.webp', siteUrl).href,
      url: pageUrl,
      startDate: `${EVENT_DATE}T15:00:00${TZ_OFFSET}`,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      isAccessibleForFree: true,
      offers: {
        '@type': 'Offer',
        price: 0,
        priceCurrency: countryMeta.Finland.currency,
        availability: 'https://schema.org/InStock',
        url: pageUrl,
      },
      location: {
        '@type': 'Place',
        name: 'Stansvik Forest',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Laajasalo, Helsinki',
          addressCountry: countryMeta.Finland.code,
        },
      },
      performer: [
        { '@id': new URL(ORGANIZATION_ID_FRAGMENT, siteUrl).href },
        { '@type': 'Person', name: 'Barbora Xu' },
        { '@type': 'Person', name: 'Tapani Rinne' },
        { '@type': 'Person', name: 'Niklas Winter' },
      ],
      organizer: { '@id': new URL(ORGANIZATION_ID_FRAGMENT, siteUrl).href },
    },
  ],
};
---

<Base
  title="Metsäkonsertti Stansvikissa, Helsingissä / Forest Concert in Stansvik, Helsinki 30.8.2026 — Old Forest Echoes"
  description={description}
  breadcrumbs={[
    { name: 'Events', href: '/events/' },
    { name: 'Forest Concert in Stansvik, Helsinki', href: PAGE_PATH },
  ]}
>
  <JsonLd data={eventGraph} />

  <section class="section" aria-labelledby="event-heading">
    <h1 id="event-heading">
      <span class="heading-line heading-accented heading-cursive" lang="fi"
        >Metsäkonsertti Stansvikissa, Helsingissä</span
      >
      <span class="heading-line">Forest Concert in <span lang="sv">Stansvik</span>, Helsinki</span>
    </h1>
    <p class="calendar-subtitle">
      <span lang="fi">Stansvikin metsä</span>, <span lang="fi">Laajasalo</span>, Helsinki<br />
      <time datetime={EVENT_DATE}
        ><span lang="fi">Sunnuntai 30.8.2026 · Konsertti klo 15.00</span> — Sunday 30 August 2026 · Concert at 15:00</time
      >
    </p>
  </section>

  <section class="section" id="suomeksi" lang="fi" aria-labelledby="fi-heading">
    <h2 id="fi-heading">Suomeksi</h2>
    <div class="prose">
      <p>
        Old Forest Echoes luo paikkasidonnaisia musiikkielämyksiä, jotka kutsuvat ihmisiä kuuntelemaan toisin —
        musiikkia, paikkaa ja metsää itseään. Jokainen konsertti muotoutuu metsän ainutlaatuisen luonteen mukaan.
      </p>
      <p>
        Tule mukaan Old Forest Echoes -kauden viimeiseen metsäkonserttiin, jossa esiintyvät Barbora Xu, Tapani Rinne ja
        Niklas Winter.
      </p>
      <h3 id="fi-land-art-heading">Maataideinstallaatio</h3>
      <p>
        Konsertti järjestetään kuvataiteilija Wiebke Pandikowin luomassa paikkasidonnaisessa maataideinstallaatiossa.
        Ympäröivästä metsästä löytyviä luonnonmateriaaleja hyödyntävä installaatio sulautuu osaksi maisemaa ja luo
        esitykselle ainutlaatuisen ympäristön jättämättä pysyvää jälkeä.
      </p>
      <p>
        Ennen konserttia voit osallistua <span lang="fi">Metsäryhmä Luonto-Liiton</span> metsän asiantuntijan opastamalle
        kävelylle <span lang="fi">Stansvikin metsään</span> ja oppia lisää alueen ainutlaatuisesta luonnosta ja historiasta.
      </p>
      <p>
        Molemmat kävelyt päättyvät suoraan konserttipaikalle. Huomioithan, että kävelyt kulkevat metsäpoluilla, joten
        suosittelemme mukavia metsään sopivia jalkineita.
      </p>
      <p>Olet myös lämpimästi tervetullut suoraan konserttiin osallistumatta kävelyyn.</p>
      <p>
        Kuuntele lisää musiikkia täältä:
        <a href={SPOTIFY_URLS.barboraXu} target="_blank" rel="noopener noreferrer">Barbora Xu</a>,
        <a href={SPOTIFY_URLS.tapaniRinne} target="_blank" rel="noopener noreferrer">Tapani Rinne</a> ja
        <a href={SPOTIFY_URLS.niklasWinter} target="_blank" rel="noopener noreferrer">Niklas Winter</a> Spotifyssa.
      </p>
      <p>
        Jos sinulla on kysyttävää, ota meihin yhteyttä osoitteessa
        <a href="mailto:info@oldforestechoes.com">info@oldforestechoes.com</a>.
      </p>
    </div>

    <h3 id="fi-schedule-heading">Opastetut retket ja konsertti</h3>
    <ScheduleList items={scheduleFi} labelledby="fi-schedule-heading" />
    <p class="booking-cta">
      <a class="support-btn" href={REGISTRATION_URL} target="_blank" rel="noopener noreferrer"> Ilmoittaudu </a>
    </p>

    <h3 id="fi-getting-there-heading">Saapuminen</h3>
    <div class="prose">
      <p>
        <span lang="fi">Herttoniemen</span> metroasemalta voit jatkaa julkisilla kulkuvälineillä ja kävellä sen jälkeen noin
        10 minuuttia metsään. Autolla saapuessasi seuraa opasteita <span lang="fi">Stansvikin kartanon</span>
        pysäköintialueelta kohti konserttipaikkaa.
      </p>
    </div>

    <p class="booking-cta">
      <a class="support-btn" href={FACEBOOK_EVENT_URL} target="_blank" rel="noopener noreferrer">Facebook-tapahtuma</a>
    </p>
  </section>

  <section class="section" id="in-english" aria-labelledby="en-heading">
    <h2 id="en-heading">In English</h2>
    <div class="prose">
      <p>
        Old Forest Echoes creates site-specific musical experiences that invite people to listen differently, to music,
        to place, and to the forest itself. Each concert is shaped by the unique character of the forest.
      </p>
      <p>
        Join us for the final Old Forest Echoes forest concert of the season, featuring Barbora Xu, Tapani Rinne, and
        Niklas Winter.
      </p>
      <h3 id="en-land-art-heading">Land Art Installation</h3>
      <p>
        The concert takes place within a site-specific land art installation created by visual artist Wiebke Pandikow.
        Using natural materials found in the surrounding forest, the installation becomes part of the landscape,
        creating a unique setting for the performance while leaving no lasting trace.
      </p>
      <p>
        Before the concert, you can join a guided walk through <span lang="fi">Stansvikin metsä</span> with a forest expert
        from <span lang="fi">Metsäryhmä Luonto-Liitto</span> and learn more about the area's unique nature and history.
      </p>
      <p>
        Both walks lead directly to the concert site. Please note that the walks take place on forest paths, so
        comfortable footwear suitable for walking in the forest is recommended.
      </p>
      <p>You are also very welcome to come directly to the concert without joining the hike.</p>
      <p>
        Listen to more music here:
        <a href={SPOTIFY_URLS.barboraXu} target="_blank" rel="noopener noreferrer">Barbora Xu</a>,
        <a href={SPOTIFY_URLS.tapaniRinne} target="_blank" rel="noopener noreferrer">Tapani Rinne</a>, and
        <a href={SPOTIFY_URLS.niklasWinter} target="_blank" rel="noopener noreferrer">Niklas Winter</a> on Spotify.
      </p>
      <p>
        If you have any questions, contact us at <a href="mailto:info@oldforestechoes.com">info@oldforestechoes.com</a>.
      </p>
    </div>

    <h3 id="en-schedule-heading">Guided Walks &amp; Concert</h3>
    <ScheduleList items={scheduleEn} labelledby="en-schedule-heading" />
    <p class="booking-cta">
      <a class="support-btn" href={REGISTRATION_URL} target="_blank" rel="noopener noreferrer"> Register </a>
    </p>

    <h3 id="en-getting-there-heading">Getting There</h3>
    <div class="prose">
      <p>
        From <span lang="fi">Herttoniemi</span> metro station, you can continue by public transport and then walk approximately
        10 minutes into the forest. If arriving by car, follow the signs from the <span lang="fi"
          >Stansvikin kartano</span
        > parking area towards the concert site.
      </p>
    </div>

    <p class="booking-cta">
      <a class="support-btn" href={FACEBOOK_EVENT_URL} target="_blank" rel="noopener noreferrer">Facebook event</a>
    </p>
  </section>

  <Support />
  <Contact />
</Base>
