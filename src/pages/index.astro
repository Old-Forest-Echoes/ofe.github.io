---
import Base from '../layouts/Base.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import Contact from '../components/Contact.astro';
import Support from '../components/Support.astro';
import JsonLd from '../components/JsonLd.astro';
import ytThumb from '../assets/images/youtube-thumbnail.webp';
import { organizationSchema } from '../data/organization';

const siteUrl = Astro.site;
if (!siteUrl) throw new Error('Astro.site must be configured in astro.config.mjs');

// YouTube thumbnail is not preloaded — on mobile the LCP element is text (larger viewport area
// than the 16:9 image), so preloading the image would only add bandwidth contention without
// improving LCP. The img tag's fetchpriority="high" still ensures early loading.

const indexGraph = {
  '@context': 'https://schema.org' as const,
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('#website', siteUrl).href,
      name: 'Old Forest Echoes',
      url: siteUrl.href,
      publisher: { '@id': new URL('#organization', siteUrl).href },
    },
    organizationSchema(siteUrl),
  ],
};
---

<Base title="Old Forest Echoes — Music for Protection of Old Growth Forests">
  <JsonLd data={indexGraph} />
  <section class="section" aria-labelledby="about-heading">
    <h1 id="about-heading">Music for Protection of Old Growth Forests</h1>
    <YouTubeEmbed
      videoId="4q2-op45wkU"
      title="Old Forest Echoes: Music for Protection of Old Growth Forests"
      thumbnail={ytThumb}
    />

    <aside class="event-feature" aria-labelledby="caisa-heading">
      <p class="event-feature-label">Live in Helsinki</p>
      <p class="event-feature-year">31.10. &amp; 1.11.2026</p>
      <h2 id="caisa-heading" class="heading-accented">Immersive indoors forest concert</h2>
      <p class="event-feature-venue">Cultural Centre Caisa, Helsinki</p>
      <div class="event-feature-programme">
        <section aria-labelledby="caisa-saturday">
          <h3 id="caisa-saturday" class="heading-accented">
            Old Forest Echoes
            <a
              href="https://www.caisa.fi/fi/tapahtumat/event/4315416BF35517CB764A83C690F786FD/Old_Forest_Echoes___Ikimets_n_kaiku__immersiivinen_luontokonsertti"
              lang="fi"
              target="_blank"
              rel="noopener noreferrer">La 31.10.</a
            >
          </h3>
          <ul>
            <li><strong>18.30</strong> Forest expert Milla Aalto introduction</li>
            <li><strong>19.00–20.00</strong> Immersive concert Barbora Xu</li>
          </ul>
          <a
            class="support-btn"
            href="https://www.lippu.fi/event/caisa-30-club-kulttuurikeskus-caisa-21702288/"
            aria-label="Tickets for 31 October 2026"
            target="_blank"
            rel="noopener noreferrer">Tickets 31.10.</a
          >
        </section>
        <section aria-labelledby="caisa-sunday">
          <h3 id="caisa-sunday" class="heading-accented">
            Old Forest Echoes
            <a
              href="https://www.caisa.fi/fi/tapahtumat/event/8376C1D627E9F010009A7F12E757C791/Old_Forest_Echoes___Ikimets_n_kaiku__immersiivinen_luontokonsertti"
              lang="fi"
              target="_blank"
              rel="noopener noreferrer">Su 1.11.</a
            >
          </h3>
          <ul>
            <li><strong>13.00–13.45</strong> Workshop for families</li>
            <li><strong>14.00–15.00</strong> Forest expert introduction &amp; concert</li>
            <li><strong>15.15–16.00</strong> Workshop for all audiences</li>
          </ul>
          <a
            class="support-btn"
            href="https://www.lippu.fi/event/caisa-30-club-kulttuurikeskus-caisa-21702289/"
            aria-label="Tickets for 1 November 2026"
            target="_blank"
            rel="noopener noreferrer">Tickets 1.11.</a
          >
        </section>
      </div>
      <p class="event-feature-facebook">
        <a href="https://fb.me/e/7ysUgYRhP" target="_blank" rel="noopener noreferrer">Facebook event</a>
      </p>
    </aside>

    <div class="prose">
      <p>
        The Old Forest Echoes (<span lang="fi">Ikimetsän kaiku</span>) aims to make you fall in love with old-growth
        forests via music and art composed and performed there.
      </p>

      <p>
        In official collaboration with the Finnish Nature League (<span lang="fi">Luonto-Liitto</span>) and the support
        of the KONE Foundation, this project aspires to raise awareness and resources to protect the threatened
        old-growth forests in Finland. An internationally acclaimed multi-instrumentalist <span lang="cs"
          >Barbora Šilhánová</span
        > (alias Barbora Xu) is recording an album rooted in a four-month-long stay in Finnish old-growth forests.
      </p>

      <p>
        These old-growth, biodiversity-rich forest areas are spread across different parts of the country. They are
        unprotected and threatened to be cut down. The trips take place from spring to autumn, when Barbora travels from
        nearby to distant old-growth forest areas in a motorhome. The forests are also visited for a shorter period of
        time by the team, consisting of jewelry and land artist Wiebke Pandikow; sound engineer and soundscape artist
        Mikko H. Haapoja; and documentary director and videographer Ville Tanttu.
      </p>

      <p>
        As a part of the project, we will take the audience to experience live concerts and workshops directly in the
        actual wild forests that inspired the music composition, organize music and land art workshops on location as
        well as release music videos and finally a documentary by Ville Tanttu, known for documentaries such as the
        award-winning <cite>Nightingales in Berlin</cite>.
      </p>

      <p>
        The profits from the album sales will go towards buying an actual patch of an old-growth forest for protection.
        The project itself is sponsored by the KONE Foundation (Finland).
      </p>

      <p>
        In addition to <span lang="cs">Barbora Šilhánová</span> (artistic director, musician), the project working group includes
        artists such as Niklas Winter, <span lang="fi">Jenni Venäläinen</span>, Ville Tanttu, Mikko H. Haapoja, and
        Wiebke Pandikow.
      </p>

      <p>The general timeline of the project is Jan 2025 to Apr 2027.</p>

      <p>
        After the tour, we will purchase a patch of old-growth forest from the donations and album sales. The Old Forest
        Echoes documentary will be shot during both years and is planned to come out in 2027.
      </p>
    </div>
  </section>

  <Support />
  <Contact />
</Base>
